
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Core account document for the trader.",
      "type": "object",
      "properties": {
        "balance": { "type": "number", "description": "Current account balance." },
        "equity": { "type": "number", "description": "Total equity including open risk." },
        "currency": { "type": "string", "enum": ["USD", "NGN", "GHS", "ZAR", "KES"] },
        "profile": {
          "type": "object",
          "properties": {
            "firstName": { "type": "string" },
            "middleName": { "type": "string" },
            "lastName": { "type": "string" },
            "fullName": { "type": "string" },
            "email": { "type": "string" },
            "phone": { "type": "string" },
            "country": { "type": "string" },
            "photoUrl": { "type": "string", "description": "URL to the user's profile picture." }
          }
        },
        "status": {
          "type": "object",
          "properties": {
            "verificationStatus": { "type": "string", "enum": ["Not Verified", "Pending", "Verified", "Rejected"] },
            "role": { "type": "string", "enum": ["Trader", "Admin"] },
            "createdAt": { "type": "string", "format": "date-time" },
            "lastLogin": { "type": "string", "format": "date-time" }
          }
        },
        "referral": {
          "type": "object",
          "properties": {
            "code": { "type": "string" },
            "referredBy": { "type": "string" }
          }
        },
        "preferences": {
          "type": "object",
          "properties": {
            "language": { "type": "string", "enum": ["ENGLISH", "FRENCH", "SPANISH", "PORTUGUESE"] },
            "timezone": { "type": "string" },
            "uiDensity": { "type": "string", "enum": ["standard", "compact"] },
            "alerts": {
              "type": "object",
              "properties": {
                "newTrades": { "type": "boolean" },
                "withdrawSuccess": { "type": "boolean" },
                "securityAlerts": { "type": "boolean" },
                "systemStatus": { "type": "boolean" }
              }
            }
          }
        }
      },
      "required": ["balance", "currency", "profile", "status"]
    },
    "Transaction": {
      "title": "Transaction Record",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "asset": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "ref": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["email", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Primary user profile node"
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": "Transaction",
      "description": "Financial ledger sub-collection"
    },
    "/users/{userId}/positions/{posId}": {
      "schema": "object",
      "description": "Trade exposure sub-collection"
    },
    "/users/{userId}/watchlist/{symbol}": {
      "schema": "object",
      "description": "User market favorites"
    },
    "/users/{userId}/notifications/{noteId}": {
      "schema": "object",
      "description": "Security and trade alerts"
    }
  }
}
