rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'macos8388@gmail.com' ||
          request.auth.token.email == 'gmaina4242@gmail.com')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status.role == 'Admin')
      );
    }

    // --- Users --------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.status.role == 'Trader'
        && request.resource.data.balance == 0
        && request.resource.data.equity == 0;

      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance', 'equity', 'referral'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (
            request.resource.data.status.diff(resource.data.status).affectedKeys().hasOnly(['verificationStatus', 'kycSubmittedAt', 'phoneVerified', 'phoneVerifiedAt'])
          )
        );

      allow update, delete: if isAdmin();

      match /{sub}/{docId} {
        allow read, write: if (isOwner(userId) || isAdmin())
          && sub in ['transactions', 'positions', 'watchlist', 'notifications', 'sessions', 'passkeys', 'bots', 'kyc_submissions'];
      }
    }

    // --- AI Conversations ---------------------------------------------------
    match /conversations/{convId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
      
      match /messages/{msgId} {
        allow read: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/conversations/$(convId)).data.userId == request.auth.uid);
        allow create: if isAdmin() || (signedIn() && get(/databases/$(database)/documents/conversations/$(convId)).data.userId == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    // --- Error Reports ------------------------------------------------------
    match /error_reports/{reportId} {
      allow create: if signedIn();
      allow read: if isAdmin();
    }

    // --- Security Nodes -----------------------------------------------------
    match /otp_codes/{uid} {
      allow read: if isOwner(uid);
      allow write: if true; 
    }

    match /challenges/{uid} {
      allow read, write: if true;
    }

    // --- Public / shared content --------------------------------------------
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /certificates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
    }
  }
}