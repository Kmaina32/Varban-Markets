rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email_verified == true && (
          request.auth.token.email == 'macos8388@gmail.com' ||
          request.auth.token.email == 'gmaina4242@gmail.com')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status.role == 'Admin')
      );
    }

    // --- Users --------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // A new account setup
      allow create: if isOwner(userId)
        && request.resource.data.status.role == 'Trader'
        && request.resource.data.balance == 0
        && request.resource.data.equity == 0;

      // Owners may edit their own profile data. Only admins can modify core status or financial fields.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance', 'equity', 'referral'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (
            request.resource.data.status.diff(resource.data.status).affectedKeys().hasOnly(['verificationStatus', 'kycSubmittedAt', 'phoneVerified', 'phoneVerifiedAt'])
          )
        );

      allow update, delete: if isAdmin();

      // Identity evidence
      match /kyc_submissions/{submissionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.status == 'Pending';
        allow update, delete: if isAdmin();
      }

      // Other per-user data
      match /{sub}/{docId} {
        allow read, write: if (isOwner(userId) || isAdmin())
          && sub in ['transactions', 'positions', 'watchlist', 'notifications', 'sessions', 'passkeys', 'bots'];
      }
    }

    // --- Security Nodes -----------------------------------------------------
    match /otp_codes/{uid} {
      // The server API uses the Web SDK (unauthenticated by default on server).
      // We allow the owner to read their own code for validation, and allow creation
      // if the document ID matches the requesting UID.
      allow read: if isOwner(uid);
      allow write: if true; 
    }

    match /challenges/{uid} {
      allow read, write: if true; // WebAuthn challenges
    }

    // --- Public / shared content --------------------------------------------
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news_cache/{cacheId} {
      allow read: if true;
      allow write: if true; 
    }

    match /site_profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{certId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- Admin auditing -----------------------------
    match /{path=**}/transactions/{txId} {
      allow read: if isAdmin();
    }

    match /{path=**}/positions/{posId} {
      allow read: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
    }
  }
}