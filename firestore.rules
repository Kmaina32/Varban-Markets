
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Determine if the requesting entity holds Root Administrative Authority
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'macos8388@gmail.com' || 
        request.auth.token.email == 'gmaina4242@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    // User Profile & Sub-collection Protocols
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }

    // Global Inbox for Support
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Platform Intelligence Articles
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Intelligence News Cache for In-App Reading
    match /news_cache/{cacheId} {
      allow read: if true;
      allow write: if true; // Internal proxy handles write verification
    }

    // Platform Configuration Authority
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Global Ledger Auditing (Collection Group Queries)
    match /{path=**}/transactions/{txId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/positions/{posId} {
      allow read: if isAdmin();
    }

    match /{path=**}/sessions/{sessId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin Activity Logging
    match /adminLogs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
    }
  }
}
