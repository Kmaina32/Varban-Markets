rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Determine if the requesting entity holds Root Administrative Authority
    // Checks both email-based whitelist and document-level role assignment
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'macos8388@gmail.com' || 
        request.auth.token.email == 'gmaina4242@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin'
      );
    }

    // User Profile & Sub-collection Protocols
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }

    // Global Inbox for Support
    match /contact_messages/{msgId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Platform Configuration Authority
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Global Ledger Auditing (Collection Group Queries)
    match /{path=**}/transactions/{txId} {
      allow read: if isAdmin();
    }
    
    match /{path=**}/positions/{posId} {
      allow read: if isAdmin();
    }
  }
}
